generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Articulo {
  id             Int             @id @default(autoincrement())
  codigo         String          @unique
  nombre         String
  categoria      String          @default("Sublimación")
  descripcion    String?         @db.Text
  imagenUrl      String?
  precioCompra   Decimal         @db.Decimal(12, 2)
  precioVenta    Decimal         @db.Decimal(12, 2)
  stockActual    Int             @default(0)
  stockMinimo    Int             @default(5)
  esCombo        Boolean         @default(false)
  creadoEn       DateTime        @default(now())
  actualizadoEn  DateTime        @updatedAt

  componentes    ComponenteCombo[]
  detallesCompra DetalleCompra[]
  detallesVenta  DetalleVenta[]

  @@map("articulos")
}

model ComponenteCombo {
  id              Int      @id @default(autoincrement())
  articuloPadreId Int
  nombre          String
  costoUnitario   Decimal  @db.Decimal(12, 2)
  cantidad        Int      @default(1)
  subtotal        Decimal  @db.Decimal(12, 2)

  articuloPadre   Articulo @relation(fields: [articuloPadreId], references: [id], onDelete: Cascade)

  @@index([articuloPadreId])
  @@map("componentes_combo")
}

model Compra {
  id          Int             @id @default(autoincrement())
  comprobante String?
  proveedor   String?
  total       Decimal         @db.Decimal(12, 2)
  observacion String?         @db.Text
  fecha       DateTime        @default(now())

  detalles    DetalleCompra[]

  @@map("compras")
}

model DetalleCompra {
  id         Int      @id @default(autoincrement())
  compraId   Int
  articuloId Int
  cantidad   Int
  precioUnit Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  compra     Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  articulo   Articulo @relation(fields: [articuloId], references: [id])

  @@index([compraId])
  @@index([articuloId])
  @@map("detalles_compra")
}

model Venta {
  id           Int            @id @default(autoincrement())
  numeroTicket String?
  cliente      String?
  metodoPago   String         @default("EFECTIVO")
  total        Decimal        @db.Decimal(12, 2)
  observacion  String?        @db.Text
  fecha        DateTime       @default(now())

  detalles     DetalleVenta[]

  @@map("ventas")
}

model DetalleVenta {
  id         Int      @id @default(autoincrement())
  ventaId    Int
  articuloId Int
  cantidad   Int
  precioUnit Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  articulo   Articulo @relation(fields: [articuloId], references: [id])

  @@index([ventaId])
  @@index([articuloId])
  @@map("detalles_venta")
}

model Configuracion {
  id    Int    @id @default(autoincrement())
  clave String @unique
  valor String

  @@map("configuraciones")
}
